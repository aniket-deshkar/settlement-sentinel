# Demo mode has zero Gemini calls and uses synthetic data only.
MODEL_MODE=demo
OPERATOR_TOKEN=change-me-operator
REVIEWER_TOKEN=change-me-reviewer
DB_PATH=data/sentinel.db

# Keep the Agent Card host and the process binding on the same origin.
A2A_HOST=127.0.0.1
A2A_PORT=8001
A2A_URL=http://127.0.0.1:8001

# To use Gemini through the Google AI Developer API free tier:
# MODEL_MODE=gemini
# GOOGLE_API_KEY=your_google_ai_studio_key
# GEMINI_MODEL=gemini-2.5-flash
